{
  "name": "painel-delivery",
  "version": "1.0.4",
  "description": "Sistema de Delivery - Painel Administrativo",
  "main": "electron/main.js",
  "author": "Painel Delivery",
  "private": true,
  "scripts": {
    "start": "node start.js",
    "setup": "setup.bat",
    "electron:dev": "concurrently \"cd backend && npm run dev\" \"cd frontend && npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:start": "electron .",
    "build": "npm run build:all",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "concurrently \"npm run build:backend\" \"npm run build:frontend\" && node scripts/prune-backend.js && electron-builder --win --publish never",
    "publish": "concurrently \"npm run build:backend\" \"npm run build:frontend\" && node scripts/prune-backend.js && node scripts/publish.js"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^34.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.delivery.painel",
    "productName": "Painel Delivery",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*"
    ],
    "compression": "store",
    "asar": true,
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "frontend",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "backend/dist",
        "to": "backend",
        "filter": [
          "**/*.js",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/*.d.ts.map"
        ]
      },
      {
        "from": "build-resources/backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "build-resources/backend/package.json",
        "to": "backend/package.json"
      }
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signingHashAlgorithms": null,
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Painel Delivery",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Kevick",
        "repo": "painel-delivery-releases",
        "releaseType": "release"
      }
    ]
  }
}
